[Unit]
Description=Comparador IPASGO Flask app
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/comparador-ipasgo
EnvironmentFile=/etc/comparador-ipasgo.env
ExecStart=/opt/comparador-ipasgo/.venv/bin/gunicorn --workers 2 --threads 4 --timeout 180 --bind 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
